{
    "info": {
        "_postman_id": "book-bridges-api-v1",
        "name": "📚 Book Bridges API",
        "description": "Complete Postman collection for the Book Bridges Spring Boot backend.\n\n**Setup:**\n1. Set the `baseUrl` variable to `http://localhost:8080`\n2. Run `POST /api/auth/login` or `POST /api/auth/register` first\n3. The login/register requests auto-set the `token` variable via the Test script\n4. All protected endpoints will automatically use the saved token",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "userId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "bookId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "transactionId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "exchangeId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "conversationId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "notificationId",
            "value": "1",
            "type": "string"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "🔐 Authentication",
            "item": [
                {
                    "name": "Register",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200 || pm.response.code === 201) {",
                                    "  var json = pm.response.json();",
                                    "  pm.collectionVariables.set('token', json.token);",
                                    "  pm.collectionVariables.set('userId', json.user.id);",
                                    "  console.log('Token saved:', json.token.substring(0, 30) + '...');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/auth/register",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Alex Student\",\n  \"email\": \"alex@university.edu\",\n  \"password\": \"password123\"\n}"
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "  var json = pm.response.json();",
                                    "  pm.collectionVariables.set('token', json.token);",
                                    "  pm.collectionVariables.set('userId', json.user.id);",
                                    "  console.log('Logged in as:', json.user.email, '| Role:', json.user.role);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/auth/login",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"alex@university.edu\",\n  \"password\": \"password123\"\n}"
                        }
                    }
                },
                {
                    "name": "Login as Admin",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "  var json = pm.response.json();",
                                    "  pm.collectionVariables.set('token', json.token);",
                                    "  pm.collectionVariables.set('userId', json.user.id);",
                                    "  console.log('Admin logged in:', json.user.email);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/auth/login",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@bookbridges.com\",\n  \"password\": \"adminpass123\"\n}"
                        }
                    }
                },
                {
                    "name": "Get Current User (me)",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/auth/me"
                    }
                },
                {
                    "name": "Logout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.collectionVariables.set('token', '');",
                                    "console.log('Token cleared');"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/api/auth/logout"
                    }
                }
            ]
        },
